## Local development example.
## Copy this file to .env and change values for your own machine.
## Do not put personal passwords, production DB passwords, or account passwords here.
MYSQL_DATABASE=error_alert
MYSQL_HOST=localhost
MYSQL_USER=error_alert
MYSQL_PASSWORD=replace_with_dev_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_dev_mysql_root_password
MYSQL_PORT=13306

REDIS_HOST=localhost
REDIS_PORT=16379

## Set false when you run MySQL and Redis without Docker Compose.
DOCKER_COMPOSE_ENABLED=true
